# ---------------------------------------------------------------------
# 1. 환경 세팅 및 라이브러리 로드
# ---------------------------------------------------------------------
# !pip install "paramiko<3.0" sshtunnel psycopg2-binary gcsfs --upgrade-strategy eager --quiet

import os
import io
import json
import warnings
import paramiko
import gcsfs
import gspread
import pandas as pd
import numpy as np
from datetime import datetime
from sshtunnel import SSHTunnelForwarder
import psycopg2
from google.cloud import bigquery, storage
from google.oauth2 import service_account

warnings.filterwarnings('ignore')

# ---------------------------------------------------------------------
# 2. 보안 정보 및 인증 세팅 (※ GitHub 공개용 마스킹 처리)
# ---------------------------------------------------------------------
# SSH 터널링 및 DB 접속 정보
SSH_HOST = 'YOUR_EC2_IP_ADDRESS'
SSH_USERNAME = 'ec2-user'
GCS_PEM_PATH = 'gs://your-bucket-name/aws-eb.pem' # GCS 내 PEM 키 경로
SERVICE_ACCOUNT_PATH = 'gs://your-bucket-name/your-service-account.json'

DB_HOST = 'your-rds-endpoint.ap-northeast-2.rds.amazonaws.com'
DB_PORT = 5432
DB_USER = 'YOUR_DB_USER'
DB_PASSWORD = 'YOUR_DB_PASSWORD'
DB_NAME = 'your_database_name'

# GCS에서 인증 파일 로드 함수
def load_gcs_file(path):
    fs = gcsfs.GCSFileSystem()
    with fs.open(path, 'rb') as f:
        return f.read()

# PEM 키 및 서비스 계정 인증 정보 준비
pem_content = load_gcs_file(GCS_PEM_PATH).decode('utf-8')
pkey = paramiko.RSAKey.from_private_key(io.StringIO(pem_content))
key_dict = json.loads(load_gcs_file(SERVICE_ACCOUNT_PATH).decode('utf-8'))

# ---------------------------------------------------------------------
# 3. 데이터 추출 (AWS RDS) : 결제 및 유저 마스터
# ---------------------------------------------------------------------
def get_db_connection():
    tunnel = SSHTunnelForwarder(
        (SSH_HOST, 22),
        ssh_username=SSH_USERNAME,
        ssh_pkey=pkey,
        remote_bind_address=(DB_HOST, DB_PORT),
        local_bind_address=('localhost', 5433)
    )
    tunnel.start()
    conn = psycopg2.connect(
        host='localhost', port=5433, database=DB_NAME,
        user=DB_USER, password=DB_PASSWORD
    )
    return tunnel, conn

print("Step 1: AWS RDS 데이터 추출 시작...")
tunnel, conn = get_db_connection()

# 결제 및 계약 데이터 추출
query_payment = """
    SELECT 
        c.contract_uid as transaction_id, 
        c.client_uid as uid,
        ph.price, 
        TO_CHAR(ph.requested_at AT TIME ZONE 'UTC' AT TIME ZONE 'KST', 'YYYY-MM-DD') as p_date,
        c.product_name,
        c.is_migrated
    FROM contract c
    LEFT JOIN payment_history ph ON c.contract_uid = ph.payment_uid
    WHERE ph.payment_status = 'DONE' AND c.actual_price > 0
"""
df_payment = pd.read_sql(query_payment, conn)
conn.close()
tunnel.stop()

# ---------------------------------------------------------------------
# 4. 데이터 추출 (BigQuery) : 행동 로그 및 매체 분류
# ---------------------------------------------------------------------
print("Step 2: BigQuery 행동 로그 병합 및 매체 분류 중...")
bq_client = bigquery.Client.from_service_account_info(key_dict)

# GA4 이벤트 로그와 유저 매칭 테이블 결합
sql_query = """
    SELECT t1.*, t2.user_id 
    FROM `your-project.MKT.MKT_eventAll_web` AS t1
    LEFT JOIN `your-project.MKT.MKT_userId_match_web` AS t2 ON t1.user_pseudo_id = t2.user_pseudo_id
    WHERE t2.user_id IS NOT NULL
"""
df_bq = bq_client.query(sql_query).to_dataframe()

# Media 분류 로직 (UTM 및 Source 기반)
def categorize_media(row):
    src = str(row['event_source']).lower()
    med = str(row['event_medium']).lower()
    cpn = str(row['event_campaign']).lower()
    
    if src in ['fbig', 'fb', 'ig']: return 'FBIG'
    if src == 'kakao': return 'Kakao'
    if src == 'navergfa': return 'NaverGFA'
    if 'naver' in src and med == 'sa': return 'NaverSA'
    if 'naver' in src and med == 'ba': return 'NaverBSA'
    if src == 'google' and med == 'sa': return 'GoogleSA'
    if src == 'google' and med == 'cpc': return 'GoogleDA'
    if med == 'crm' or src in ['alimtalk', 'mms']: return 'CRM'
    return 'Organic/ETC'

df_bq['Media'] = df_bq.apply(categorize_media, axis=1)

# ---------------------------------------------------------------------
# 5. MTA(Multi-Touch Attribution) 모델링
# ---------------------------------------------------------------------
print("Step 3: MTA 모델링 산출 중 (Last, 1st, Linear)...")

# 결제 데이터와 행동 로그 결합
df_payment['uid'] = df_payment['uid'].astype(str)
df_bq['user_id'] = df_bq['user_id'].astype(str)
df_mta = pd.merge(df_payment, df_bq, left_on='uid', right_on='user_id', how='left')

# [Model 1] Last Click
df_mta['rank_desc'] = df_mta.groupby('uid')['event_timestamp'].rank(ascending=False, method='first')
df_last = df_mta[df_mta['rank_desc'] == 1].groupby(['p_date', 'Media']).agg(
    구매수_LastClick=('uid', 'count'),
    거래액_LastClick=('price', 'sum')
).reset_index()

# [Model 2] 1st Click
df_mta['rank_asc'] = df_mta.groupby('uid')['event_timestamp'].rank(ascending=True, method='first')
df_first = df_mta[df_mta['rank_asc'] == 1].groupby(['p_date', 'Media']).agg(
    구매수_1stClick=('uid', 'count'),
    거래액_1stClick=('price', 'sum')
).reset_index()

# [Model 3] Linear Attribution (균등 기여)
df_linear_base = df_mta.copy()
df_linear_base['touch_count'] = df_linear_base.groupby('uid')['Media'].transform('count')
df_linear_base['weight'] = 1 / df_linear_base['touch_count']
df_linear = df_linear_base.groupby(['p_date', 'Media']).agg(
    구매수_Linear=('weight', 'sum'),
    거래액_Linear=('price', 'sum') # 실제로는 (price * weight)의 합산
).reset_index()

# 모델 통합
final_mta_df = pd.merge(df_last, df_first, on=['p_date', 'Media'], how='outer')
final_mta_df = pd.merge(final_mta_df, df_linear, on=['p_date', 'Media'], how='outer').fillna(0)

# ---------------------------------------------------------------------
# 6. 결과 적재 (Google Sheets & BigQuery)
# ---------------------------------------------------------------------
print("Step 4: 데이터 적재 및 자동화 완료")

# 구글 시트 업데이트 (Tableau/Looker 연동용) [cite: 93, 94]
gc = gspread.service_account_from_dict(key_dict)
sh = gc.open_by_key('YOUR_SPREADSHEET_ID')
wks = sh.worksheet('U_DA_MTA_Raw')
wks.update([final_mta_df.columns.values.tolist()] + final_mta_df.values.tolist())

# BigQuery 데이터 마트 적재 [cite: 98]
table_id = "your-project.MKT.U_DA_MTA_MART"
job_config = bigquery.LoadJobConfig(write_disposition="WRITE_TRUNCATE")
bq_client.load_table_from_dataframe(final_mta_df, table_id, job_config=job_config).result()

print(f"✅ 파이프라인 실행 완료: {datetime.now()}")
